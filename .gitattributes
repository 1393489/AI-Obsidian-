# Keep the repo byte-identical on every platform: these files are written by memloom
# itself and compared with plain string equality, so a stray CRLF is a real bug here.
* text=auto eol=lf

*.py      text eol=lf
*.md      text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.jsonl   text eol=lf
*.svg     text eol=lf
*.gitignore text eol=lf

*.zstd    binary
*.png     binary
